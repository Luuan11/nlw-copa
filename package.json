{
  "name": "nlw-copa-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NLW Copa - Monorepo Turborepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "lodash": "^4.17.23",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
